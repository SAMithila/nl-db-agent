    "generated_sql": "SELECT i.BillingCountry, SUM(il.UnitPrice * il.Quantity) AS total_revenue FROM Invoice i JOIN InvoiceLine il ON i.InvoiceId = il.InvoiceId GROUP BY i.BillingCountry ORDER BY total_revenue DESC LIMIT 100;",
