      "Genre"
    ],
    "generated_sql": "SELECT g.Name AS genre_name, SUM(il.UnitPrice * il.Quantity) AS genre_revenue, (SUM(il.UnitPrice * il.Quantity) * 100.0 / (SELECT SUM(UnitPrice * Quantity) FROM InvoiceLine)) AS revenue_percentage FROM InvoiceLine il JOIN Track t ON il.TrackId = t.TrackId JOIN Genre g ON t.GenreId = g.GenreId GROUP BY g.GenreId, g.Name ORDER BY revenue_percentage DESC LIMIT 100;",
    "sql_confidence": "high",
    "sql_explanation": "This query calculates the total revenue for each genre by summing the product of UnitPrice and Quantity from the InvoiceLine table, grouped by genre. It then calculates the percentage contribution of each genre's revenue to the total revenue from all InvoiceLines.",
    "sql_assumptions": "Assumes that each Track is associated with exactly one Genre.",
