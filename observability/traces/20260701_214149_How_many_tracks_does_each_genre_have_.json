    "generated_sql": "SELECT g.Name AS genre_name, COUNT(t.TrackId) AS track_count FROM Genre g LEFT JOIN Track t ON g.GenreId = t.GenreId GROUP BY g.GenreId, g.Name LIMIT 100;",
