      "Invoice"
    ],
    "generated_sql": "SELECT g.Name AS genre_name, SUM(il.UnitPrice * il.Quantity) AS genre_revenue, (SUM(il.UnitPrice * il.Quantity) / (SELECT SUM(UnitPrice * Quantity) FROM InvoiceLine) * 100) AS revenue_percentage FROM InvoiceLine il JOIN Track t ON il.TrackId = t.TrackId JOIN Genre g ON t.GenreId = g.GenreId GROUP BY g.GenreId, g.Name ORDER BY revenue_percentage DESC LIMIT 100;",
    "sql_confidence": "high",
    "sql_explanation": "This query calculates the total revenue generated by each genre and then computes the percentage contribution of each genre's revenue to the total revenue from all genres. It joins the InvoiceLine table with the Track and Genre tables to group the revenue by genre.",
