    "generated_sql": "SELECT c.CustomerId, c.FirstName, c.LastName, COUNT(DISTINCT t.GenreId) AS GenreCount FROM Customer c JOIN Invoice i ON c.CustomerId = i.CustomerId JOIN InvoiceLine il ON i.InvoiceId = il.InvoiceId JOIN Track t ON il.TrackId = t.TrackId GROUP BY c.CustomerId HAVING GenreCount > 5 LIMIT 100;",
    "sql_confidence": "high",
    "sql_explanation": "This query retrieves customers who have purchased tracks from more than 5 different genres. It joins the Customer, Invoice, InvoiceLine, and Track tables, counts the distinct genres per customer, and filters for those with more than 5 genres.",
