    "generated_sql": "SELECT c.Country, SUM(il.UnitPrice * il.Quantity) AS total_revenue FROM InvoiceLine il JOIN Invoice i ON il.InvoiceId = i.InvoiceId JOIN Customer c ON i.CustomerId = c.CustomerId GROUP BY c.Country LIMIT 100;",
