    "generated_sql": "SELECT AVG(track_count) AS average_tracks_per_album FROM (SELECT a.AlbumId, COUNT(t.TrackId) AS track_count FROM Album a LEFT JOIN Track t ON a.AlbumId = t.AlbumId GROUP BY a.AlbumId) subquery;",
