    "generated_sql": "SELECT g.Name AS genre_name, SUM(il.UnitPrice * il.Quantity) AS total_revenue FROM InvoiceLine il JOIN Track t ON il.TrackId = t.TrackId JOIN Genre g ON t.GenreId = g.GenreId GROUP BY g.GenreId, g.Name LIMIT 100;",
